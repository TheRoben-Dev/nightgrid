{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightgrid",
  "mainBinaryName": "nightgrid",
  "version": "../package.json",
  "identifier": "dev.nightgrid.Nightgrid",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NIGHTGRID",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#07080B",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: asset:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Homelab command center",
    "longDescription": "Agentless desktop app for managing a homelab over SSH: terminals, files, Docker, monitoring, services and tunnels.",
    "copyright": "© 2026 TheRoben",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    }
  }
}
